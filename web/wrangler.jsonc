/**
 * Cấu hình Cloudflare Worker cho web thư viện mẫu 3D.
 * Thay các giá trị [..] / REPLACE_ME bằng thông tin thật (xem README).
 * Secrets (không ghi ở đây) đặt bằng: pnpm wrangler secret put <TÊN>
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "thu-vien-3d",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"routes": [{ "pattern": "ke.tihado.com", "custom_domain": true }],

	"vars": {
		"PUBLIC_SITE_URL": "https://ke.tihado.com",
		"SITE_NAME": "Kê",
		"MEDIA_PUBLIC_URL": "https://tv3d.tihado.com",
		"R2_ACCOUNT_ID": "c212bdff76b66f998bebf5889206dc0c",
		"MODELS_BUCKET_NAME": "tv3d-models",
		"R2_EVICT_DAYS": "30",
		"DOWNLOAD_LINK_TTL_HOURS": "72",
		"PRESIGN_TTL_SECONDS": "900",
		"TYPESENSE_URL": "https://search.example.com",
		"TYPESENSE_COLLECTION": "models",
		"BANK_BIN": "970436",
		"BANK_ACCOUNT_NO": "REPLACE_ME",
		"BANK_ACCOUNT_NAME": "REPLACE_ME",
		"ORDER_CODE_PREFIX": "TV3D",
		"EMAIL_FROM": "Kê <no-reply@example.com>"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tv3d",
			"database_id": "c83c0cf2-f093-42db-80f6-62289a5da1a9",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [
		// public: ảnh preview & ảnh nội dung (gắn custom domain = MEDIA_PUBLIC_URL)
		{ "binding": "MEDIA", "bucket_name": "tv3d-media" },
		// private: file mẫu .zip
		{ "binding": "MODELS", "bucket_name": "tv3d-models" }
	],

	"queues": {
		"producers": [
			// job đẩy file lên R2 – tool máy nhà kéo về (pull consumer)
			{ "binding": "UPLOAD_QUEUE", "queue": "tv3d-upload" },
			// đồng bộ Typesense – Worker tự xử lý
			{ "binding": "SEARCH_QUEUE", "queue": "tv3d-search-sync" }
		],
		// tv3d-upload dùng HTTP pull consumer, tạo bằng lệnh (xem README):
		//   pnpm wrangler queues consumer http add tv3d-upload --visibility-timeout-secs 1800
		"consumers": [
			{ "queue": "tv3d-search-sync", "max_batch_size": 20, "max_batch_timeout": 5, "max_retries": 50, "retry_delay": 300 }
		]
	},

	"triggers": {
		// 19:00 UTC = 2h sáng giờ Việt Nam: dọn R2, đẩy lại job kẹt, hết hạn link
		"crons": ["0 19 * * *"]
	}
}
