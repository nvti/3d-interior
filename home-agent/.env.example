# Copy thành .env rồi điền giá trị thật

# Thư mục gốc của thư viện mẫu trên ổ cứng
LIBRARY_ROOT=/Volumes/Thu-vien-3D
# Nơi tool lưu trạng thái + file zip tạm (cần trống ít nhất bằng dung lượng mẫu lớn nhất)
WORK_DIR=./.agent

# Website (Worker) và token chung với secret AGENT_TOKEN của Worker
SITE_URL=https://example.com
AGENT_TOKEN=

# Cloudflare R2 – tạo API token R2 có quyền Object Read & Write cho 2 bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=tv3d-media
R2_MODELS_BUCKET=tv3d-models

# Cloudflare Queues (HTTP pull) – API token có quyền "Queues: Edit"
CF_API_TOKEN=
# ID của queue tv3d-upload: pnpm wrangler queues info tv3d-upload
UPLOAD_QUEUE_ID=

# Typesense chạy local bằng docker compose
TYPESENSE_API_KEY=
TYPESENSE_LOCAL_URL=http://localhost:8108
TYPESENSE_COLLECTION=models
TYPESENSE_EMBED_MODEL=ts/multilingual-e5-small
# Model CLIP cho tìm bằng ảnh
TYPESENSE_IMAGE_MODEL=ts/clip-vit-b-p32

# Cloudflare Tunnel (lấy token khi tạo tunnel trong Zero Trust dashboard)
TUNNEL_TOKEN=
# Tuỳ chọn – để ./agent.sh test kiểm tra tunnel từ internet
# Public hostname của tunnel (trỏ tới http://typesense:8108)
TUNNEL_HOSTNAME=
# Service token của Cloudflare Access (giống 2 secret CF_ACCESS_CLIENT_* của Worker)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
