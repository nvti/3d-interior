# Chạy thử local cùng website (cd ../web && pnpm dev). Copy thành .env:  cp .env.local.example .env
# Không cần tài khoản Cloudflare: ảnh và file zip đi qua R2 giả lập của website local.
R2_MODE=local

# Thư viện thử, tạo bằng: pnpm sample
LIBRARY_ROOT=./sample-library
WORK_DIR=./.agent

SITE_URL=http://localhost:5173
# Khớp AGENT_TOKEN trong web/.dev.vars
AGENT_TOKEN=dev-agent-token

# Typesense local (tuỳ chọn): docker compose up -d typesense
# Khớp TYPESENSE_API_KEY trong web/.dev.vars
TYPESENSE_API_KEY=local-typesense-key
TYPESENSE_LOCAL_URL=http://localhost:8108
TYPESENSE_COLLECTION=models
TYPESENSE_EMBED_MODEL=ts/multilingual-e5-small

# Tuỳ chọn – Claude viết tiêu đề, mô tả, tag khi nhập mẫu từ trang admin (/admin/library)
ANTHROPIC_API_KEY=
